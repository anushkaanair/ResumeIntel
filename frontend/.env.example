# ── Backend URL ──────────────────────────────────────────────────────────────
# Production: set to your deployed API URL
VITE_API_URL=http://localhost:8000/api/v1

# ── WebSocket URL (optional) ─────────────────────────────────────────────────
# Only set if your WS host differs from VITE_API_URL (e.g. separate WS gateway)
# VITE_WS_URL=ws://localhost:8000

# ── API Key (C1) ──────────────────────────────────────────────────────────────
# Must match API_SECRET_KEY in backend .env when auth is enabled
VITE_API_KEY=

# ── Sentry (H7, optional) ────────────────────────────────────────────────────
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
