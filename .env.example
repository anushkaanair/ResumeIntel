# ── LLM ──────────────────────────────────────────────────────────────────────
# OpenAI (default) — or any OpenAI-compatible endpoint via OPENAI_BASE_URL (Groq, Together, vLLM…)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Local models with Ollama (resume text never leaves your machine). Use a model that fits in RAM;
# 3B-class models run everywhere but write noticeably weaker resumes than a hosted model.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:3b

# ── Storage ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400          # how long finished results are kept
FAISS_INDEX_DIR=./data/faiss_indices

# ── Behaviour ────────────────────────────────────────────────────────────────
ALIGNMENT_THRESHOLD=0.33         # resume↔JD cosine below this skips tailoring (see README)

# ── Access control (set both for any deployment reachable from the internet) ──
API_SECRET_KEY=                  # long random string; the UI asks for it once
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8000
FRONTEND_BASE_URL=http://localhost:5173

# ── Optional: profile sync (LinkedIn / GitHub OAuth) ─────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ACCESS_TOKEN=
